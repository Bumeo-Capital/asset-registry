{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/LUNCPumpfun/asset-registry/main/schemas/connections.schema.json",
  "title": "LSF bridge connections",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "connections"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "protocol", "lifecycle", "endpoints", "assetMappings", "evidenceUrls", "sourceIds"],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "protocol": { "enum": ["ibc", "hyperlane"] },
          "lifecycle": { "enum": ["active", "deprecated"] },
          "endpoints": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["chain", "endpointType", "port", "channel", "connection", "client"],
                  "properties": {
                    "chain": { "type": "string" },
                    "endpointType": { "const": "ibc" },
                    "port": { "type": "string" },
                    "channel": { "type": "string" },
                    "connection": { "type": "string" },
                    "client": { "type": "string" }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["chain", "endpointType", "domain", "router"],
                  "properties": {
                    "chain": { "type": "string" },
                    "endpointType": { "const": "hyperlane" },
                    "domain": { "type": "integer", "minimum": 0 },
                    "router": { "type": "string" },
                    "mailbox": { "type": "string" },
                    "tokenIdentifier": { "type": "string" }
                  }
                }
              ]
            }
          },
          "assetMappings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sourceRepresentation", "destinationRepresentation"],
              "properties": {
                "sourceRepresentation": { "type": "string" },
                "destinationRepresentation": { "type": "string" }
              }
            }
          },
          "evidenceUrls": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "format": "uri" }
          },
          "sourceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
        }
      }
    }
  }
}
