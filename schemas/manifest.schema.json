{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/LUNCPumpfun/asset-registry/main/schemas/manifest.schema.json",
  "title": "LSF asset registry manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "registryVersion", "status", "updatedAt", "files", "sources"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "registryVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": { "enum": ["initial", "stable", "deprecated"] },
    "updatedAt": { "type": "string", "format": "date" },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": ["api-snapshot", "repository-snapshot", "onchain-query", "official-documentation", "product-decision"]
          },
          "url": { "type": "string" },
          "asOf": { "type": "string" },
          "repository": { "type": "string" },
          "commit": { "type": "string" },
          "tokenCount": { "type": "integer", "minimum": 0 },
          "representationIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string" }
          },
          "note": { "type": "string" }
        }
      }
    }
  }
}
