{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/LUNCPumpfun/asset-registry/main/schemas/representations.schema.json",
  "title": "LSF chain-local asset representations",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "representations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "representations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "canonicalAsset", "chain", "standard", "identifier", "decimals", "verification", "lifecycle", "visibility", "sourceIds"],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "canonicalAsset": { "type": "string", "minLength": 1 },
          "chain": { "type": "string", "minLength": 1 },
          "standard": { "enum": ["cosmos-native", "cosmos-tokenfactory", "cw20", "ibc", "evm-native", "erc20", "solana-native", "spl", "token-2022"] },
          "identifier": { "type": "string", "minLength": 1 },
          "decimals": { "type": "integer", "minimum": 0, "maximum": 255 },
          "provenance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["originRepresentation", "transportRef"],
              "properties": {
                "originRepresentation": { "type": "string" },
                "transportRef": { "type": "string" }
              }
            }
          },
          "verification": { "enum": ["verified", "unverified"] },
          "lifecycle": { "enum": ["active", "deprecated"] },
          "visibility": { "enum": ["required", "default", "optional", "hidden"] },
          "sourceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
        }
      }
    }
  }
}
